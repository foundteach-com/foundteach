{
  "name": "foundteach-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@foundteach/web",
    "build:api": "turbo build --filter=@foundteach/api",
    "build:admin": "turbo build --filter=@foundteach/admin",
    "build:videogame": "turbo build --filter=@foundteach/videogame",
    "build:blog": "turbo build --filter=@foundteach/blog",
    "build:desarrollohumano": "turbo build --filter=@foundteach/videogame",
    "lint": "turbo lint",
    "start": "turbo start",
    "start:web": "npm run start --workspace=@foundteach/web",
    "start:api": "npm run start:prod --workspace=@foundteach/api",
    "start:admin": "npm run start --workspace=@foundteach/admin",
    "start:videogame": "npm run start --workspace=@foundteach/videogame",
    "start:blog": "npm run start --workspace=@foundteach/blog",
    "start:desarrollohumano": "npm run start --workspace=@foundteach/videogame"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "turbo": "^2.1.2"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
