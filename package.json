{
  "name": "foundteach-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@foundteach/web",
    "build:api": "turbo build --filter=@foundteach/api",
    "lint": "turbo lint",
    "start": "turbo start",
    "start:web": "npm run start --workspace=@foundteach/web",
    "start:api": "npm run start:prod --workspace=@foundteach/api"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "turbo": "^2.1.2"
  },
  "packageManager": "npm@11.6.2"
}
