// FoundTeach — Prisma Schema
// Servicios: Sitio Institucional, Plataforma Administrativa, Plataforma Educativa (futuro)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
  TEACHER
  STUDENT
}

enum ContactStatus {
  PENDING
  READ
  REPLIED
  ARCHIVED
}

// ─── HCM ENUMS ───────────────────────────────────────────────────────────────

enum EmployeeType {
  FOUNDER
  EMPLOYEE
  INSTRUCTOR
  FREELANCER
  INTERN
}

enum ContractType {
  FIXED_TERM
  INDEFINITE
  SERVICE_CONTRACT
  INTERNSHIP
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

// ─── SD ENUMS ────────────────────────────────────────────────────────────────

enum CustomerType {
  COMPANY
  INDIVIDUAL
  SCHOOL
  UNIVERSITY
  GOVERNMENT
}

enum ProductCategory {
  GEOMATH_LICENSE
  SOFTWARE_PROJECT
  CONSULTING
  TRAINING
  SUPPORT
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PipelineStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// ─── FI ENUMS ────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryType {
  DEBIT
  CREDIT
}

enum EntryStatus {
  DRAFT
  POSTED
  CANCELLED
}


// ─── USUARIOS (núcleo compartido por todos los servicios) ────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      Role     @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─── SITIO INSTITUCIONAL ─────────────────────────────────────────────────────

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("contact_messages")
}

// ─── PLATAFORMA ADMINISTRATIVA ───────────────────────────────────────────────

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model CompanyConfig {
  id        String   @id @default(uuid())
  name      String   @default("FoundTeach EdTech S.A.S")
  email     String?
  phone     String?
  website   String?
  address   String?
  logoUrl   String?  @map("logo_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_config")
}

model Document {
  id         String   @id @default(uuid())
  name       String
  filename   String
  url        String
  mimetype   String
  size       Int
  category   String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("documents")
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // "INCOME" | "EXPENSE"
  amount      Float
  description String
  category    String
  date        DateTime
  reference   String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("transactions")
}

model Billing {
  id          String   @id @default(uuid())
  number      String   @unique
  type        String   // "RECEIVABLE" | "PAYABLE"
  party       String
  amount      Float
  tax         Float    @default(0)
  status      String   @default("PENDING")
  issueDate   DateTime @map("issue_date")
  dueDate     DateTime @map("due_date")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("billings")
}

// ─── GEOMATCH (juego educativo) ──────────────────────────────────────────────

model GamePlayer {
  id           String   @id @default(uuid())
  name         String
  studentCode  String   @unique @map("student_code")
  totalScore   Int      @default(0) @map("total_score")
  highestLevel Int      @default(1) @map("highest_level")
  lastLevel    Int      @default(1) @map("last_level")
  roundsPlayed Int      @default(0) @map("rounds_played")
  levelsData   Json?    @map("levels_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("game_players")
}

// ─── HCM — MÓDULO DE CAPITAL HUMANO ─────────────────────────────────────────

model Employee {
  id             String       @id @default(uuid())
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String       @unique
  phone          String?
  documentType   String       @default("CC") @map("document_type")
  documentNumber String       @unique @map("document_number")
  position       String       // Cargo / Puesto
  department     String?      // Área (Tecnología, Educación, Admin...)
  employeeType   EmployeeType @default(EMPLOYEE) @map("employee_type")
  startDate      DateTime     @map("start_date")
  birthDate      DateTime?    @map("birth_date")
  address        String?
  city           String?      @default("Colombia")
  isActive       Boolean      @default(true) @map("is_active")
  notes          String?
  avatarUrl      String?      @map("avatar_url")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  contracts      Contract[]
  payrolls       Payroll[]
  timeEntries    TimeEntry[]
  skills         EmployeeSkill[]
  reviews        PerformanceReview[]

  @@map("employees")
}

model Contract {
  id             String         @id @default(uuid())
  employeeId     String         @map("employee_id")
  contractType   ContractType   @map("contract_type")
  status         ContractStatus @default(ACTIVE)
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  salary         Decimal        @db.Decimal(12, 2)
  currency       String         @default("COP")
  workHoursPerWeek Int          @default(40) @map("work_hours_per_week")
  description    String?
  documentUrl    String?        @map("document_url")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Payroll {
  id             String        @id @default(uuid())
  employeeId     String        @map("employee_id")
  period         String        // "2026-03" = Año-Mes
  baseSalary     Decimal       @map("base_salary") @db.Decimal(12, 2)
  bonuses        Decimal       @default(0) @db.Decimal(12, 2)
  deductions     Decimal       @default(0) @db.Decimal(12, 2)
  netPay         Decimal       @map("net_pay") @db.Decimal(12, 2)
  currency       String        @default("COP")
  status         PayrollStatus @default(PENDING)
  paidAt         DateTime?     @map("paid_at")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payrolls")
}

// ─── SD — MÓDULO DE VENTAS Y DISTRIBUCIÓN ────────────────────────────────────

model Customer {
  id             String       @id @default(uuid())
  name           String                          // Empresa o nombre completo
  customerType   CustomerType @default(COMPANY) @map("customer_type")
  email          String?
  phone          String?
  contactPerson  String?      @map("contact_person")  // Nombre del contacto
  documentNumber String?      @map("document_number") // NIT o Cédula
  address        String?
  city           String?
  country        String?      @default("Colombia")
  website        String?
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  quotes         Quote[]
  invoices       Invoice[]
  deals          Deal[]
  projects       Project[]
  tickets        SupportTicket[]

  @@map("customers")
}

model Product {
  id           String          @id @default(uuid())
  name         String
  code         String          @unique           // Ej: GM-LIC-001
  description  String?
  category     ProductCategory @default(OTHER)
  unitPrice    Decimal         @map("unit_price") @db.Decimal(12, 2)
  currency     String          @default("COP")
  unit         String          @default("unidad") // "licencia", "hora", "mes"
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  quoteItems   QuoteItem[]
  invoiceItems InvoiceItem[]

  @@map("products")
}

model Quote {
  id           String      @id @default(uuid())
  quoteNumber  String      @unique @map("quote_number") // COT-2026-001
  customerId   String      @map("customer_id")
  status       QuoteStatus @default(DRAFT)
  validUntil   DateTime?   @map("valid_until")
  subtotal     Decimal     @default(0) @db.Decimal(12, 2)
  taxPercent   Decimal     @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount    Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total        Decimal     @default(0) @db.Decimal(12, 2)
  currency     String      @default("COP")
  notes        String?
  terms        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  customer     Customer    @relation(fields: [customerId], references: [id])
  items        QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String   @map("quote_id")
  productId   String?  @map("product_id")
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(12, 2)

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number") // FAC-2026-001
  customerId    String        @map("customer_id")
  quoteId       String?       @map("quote_id")
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  paidAt        DateTime?     @map("paid_at")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxPercent    Decimal       @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("COP")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer      Customer      @relation(fields: [customerId], references: [id])
  items         InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  productId   String?  @map("product_id")
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(12, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

model Deal {
  id           String        @id @default(uuid())
  title        String
  customerId   String        @map("customer_id")
  stage        PipelineStage @default(PROSPECT)
  value        Decimal?      @db.Decimal(12, 2)   // Valor estimado
  currency     String        @default("COP")
  expectedDate DateTime?     @map("expected_date")
  closedAt     DateTime?     @map("closed_at")
  probability  Int           @default(10)          // % probabilidad de cierre
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  customer     Customer      @relation(fields: [customerId], references: [id])

  @@map("deals")
}

// ─── FI — MÓDULO DE FINANZAS ──────────────────────────────────────────────────

model Account {
  id          String      @id @default(uuid())
  code        String      @unique                  // Código de cuenta (ej. 1105)
  name        String                             // Nombre de cuenta (ej. Caja General)
  type        AccountType                        // ASSET, LIABILITY, etc.
  description String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  entries     JournalEntryLine[]

  @@map("accounts")
}

model JournalEntry {
  id          String        @id @default(uuid())
  entryNumber String        @unique @map("entry_number") // AS-2026-001
  date        DateTime
  description String
  status      EntryStatus   @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  lines       JournalEntryLine[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id          String       @id @default(uuid())
  entryId     String       @map("entry_id")
  accountId   String       @map("account_id")
  type        EntryType    // DEBIT or CREDIT
  amount      Decimal      @db.Decimal(12, 2)
  description String?

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id])

  @@map("journal_entry_lines")
}

// ─── OPERACIONES ──────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  progress    Int      @default(0)          // 0-100
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  budget      Float?
  responsible String?
  color       String?  @default("#6366f1")
  customerId  String?  @map("customer_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer     Customer?      @relation(fields: [customerId], references: [id])
  tasks        ProjectTask[]
  deliverables Deliverable[]
  tickets      SupportTicket[]
  repositories Repository[]
  bugs         Bug[]
  timeEntries  TimeEntry[]

  @@map("projects")
}

model ProjectTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO")    // TODO | IN_PROGRESS | REVIEW | DONE
  priority    String   @default("MEDIUM")  // LOW | MEDIUM | HIGH | CRITICAL
  assignee    String?
  dueDate     DateTime? @map("due_date")
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_tasks")
}

model Deliverable {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  fileUrl     String?  @map("file_url")
  dueDate     DateTime? @map("due_date")
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("deliverables")
}

model SupportTicket {
  id          String   @id @default(uuid())
  subject     String
  description String?
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String   @default("OPEN")   // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  reporter    String?
  assignee    String?
  projectId   String?  @map("project_id")
  customerId  String?  @map("customer_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project  Project?  @relation(fields: [projectId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("support_tickets")
}

// ─── DEV MANAGEMENT ──────────────────────────────────────────────────────────

model Repository {
  id            String   @id @default(uuid())
  name          String
  url           String?                         // GitHub / GitLab URL
  language      String?
  description   String?
  defaultBranch String?  @default("main") @map("default_branch")
  isActive      Boolean  @default(true)   @map("is_active")
  projectId     String?  @map("project_id")
  createdAt     DateTime @default(now())  @map("created_at")
  updatedAt     DateTime @updatedAt       @map("updated_at")

  project     Project?     @relation(fields: [projectId], references: [id])
  deployments Deployment[]
  bugs        Bug[]

  @@map("repositories")
}

model Deployment {
  id          String   @id @default(uuid())
  version     String                          // v1.2.0 or commit sha
  environment String   @default("PROD")       // DEV | STAGING | PROD
  status      String   @default("IN_PROGRESS") // SUCCESS | FAILED | IN_PROGRESS | ROLLED_BACK
  notes       String?
  deployedBy  String?  @map("deployed_by")
  deployedAt  DateTime @default(now())  @map("deployed_at")
  repoId      String   @map("repo_id")
  createdAt   DateTime @default(now())  @map("created_at")

  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

model Bug {
  id               String   @id @default(uuid())
  title            String
  description      String?
  severity         String   @default("MEDIUM")  // LOW | MEDIUM | HIGH | CRITICAL
  status           String   @default("OPEN")    // OPEN | IN_PROGRESS | FIXED | WONT_FIX | CLOSED
  assignee         String?
  stepsToReproduce String?  @map("steps_to_reproduce")
  labels           String?                       // comma-separated tags
  repoId           String   @map("repo_id")
  projectId        String?  @map("project_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  project    Project?   @relation(fields: [projectId], references: [id])

  @@map("bugs")
}


model TimeEntry {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  date        DateTime
  hours       Float
  description String?
  projectId   String?  @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id])

  @@map("time_entries")
}

model EmployeeSkill {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  name       String
  level      String   @default("INTERMEDIATE")
  category   String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_skills")
}

model PerformanceReview {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  period       String
  score        Int
  strengths    String?
  improvements String?
  reviewerName String?  @map("reviewer_name")
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("performance_reviews")
}
