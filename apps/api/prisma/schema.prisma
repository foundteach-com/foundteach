// FoundTeach — Prisma Schema
// Servicios: Sitio Institucional, Plataforma Administrativa, Plataforma Educativa (futuro)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
  TEACHER
  STUDENT
}

enum ContactStatus {
  PENDING
  READ
  REPLIED
  ARCHIVED
}

// ─── USUARIOS (núcleo compartido por todos los servicios) ────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      Role     @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─── SITIO INSTITUCIONAL ─────────────────────────────────────────────────────

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("contact_messages")
}

// ─── PLATAFORMA ADMINISTRATIVA ───────────────────────────────────────────────

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

// ─── GEOMATCH (juego educativo) ──────────────────────────────────────────────

model GamePlayer {
  id           String   @id @default(uuid())
  name         String
  studentCode  String   @unique @map("student_code")
  totalScore   Int      @default(0) @map("total_score")
  highestLevel Int      @default(1) @map("highest_level")
  lastLevel    Int      @default(1) @map("last_level")
  roundsPlayed Int      @default(0) @map("rounds_played")
  levelsData   Json?    @map("levels_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("game_players")
}
