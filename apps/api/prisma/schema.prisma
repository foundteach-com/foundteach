// FoundTeach — Prisma Schema
// Servicios: Sitio Institucional, Plataforma Administrativa, Plataforma Educativa, Videojuego

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
  TEACHER
  STUDENT
}

enum ContactStatus {
  PENDING
  READ
  REPLIED
  ARCHIVED
}

// ─── HCM ENUMS ───────────────────────────────────────────────────────────────

enum EmployeeType {
  FOUNDER
  EMPLOYEE
  INSTRUCTOR
  FREELANCER
  INTERN
}

enum ContractType {
  FIXED_TERM
  INDEFINITE
  SERVICE_CONTRACT
  INTERNSHIP
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

// ─── SD ENUMS ────────────────────────────────────────────────────────────────

enum CustomerType {
  COMPANY
  INDIVIDUAL
  SCHOOL
  UNIVERSITY
  GOVERNMENT
}

enum ProductCategory {
  GEOMATH_LICENSE
  SOFTWARE_PROJECT
  CONSULTING
  TRAINING
  SUPPORT
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PipelineStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// ─── FI ENUMS ────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryType {
  DEBIT
  CREDIT
}

enum EntryStatus {
  DRAFT
  POSTED
  CANCELLED
}


// ─── USUARIOS E INICIOS DE SESIÓN (Núcleo Plataforma Admin y Educativa) ──────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         Role     @default(USER) // ADMIN, USER, TEACHER, STUDENT
  isActive     Boolean  @default(true) @map("is_active")
  
  // ── Vida Educativa y Videojuego (Migrados desde GamePlayer)
  studentCode  String?  @unique @map("student_code")
  totalScore   Int      @default(0) @map("total_score")
  highestLevel Int      @default(1) @map("highest_level")
  lastLevel    Int      @default(1) @map("last_level")
  roundsPlayed Int      @default(0) @map("rounds_played")
  levelsData   Json?    @map("levels_data")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  gameSessions GameSession[]
  enrollments  Enrollment[]   // Nueva relación directa con Plataforma Educativa

  @@map("users")
}

// ─── SITIO INSTITUCIONAL ─────────────────────────────────────────────────────

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("contact_messages")
}

// ─── PLATAFORMA ADMINISTRATIVA ───────────────────────────────────────────────

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model CompanyConfig {
  id        String   @id @default(uuid())
  name      String   @default("FoundTeach EdTech S.A.S")
  email     String?
  phone     String?
  website   String?
  address   String?
  logoUrl   String?  @map("logo_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_config")
}

model Document {
  id         String   @id @default(uuid())
  name       String
  filename   String
  url        String
  mimetype   String
  size       Int
  category   String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("documents")
}

// ─── HCM — MÓDULO DE CAPITAL HUMANO ─────────────────────────────────────────

model Employee {
  id             String       @id @default(uuid())
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String       @unique
  phone          String?
  documentType   String       @default("CC") @map("document_type")
  documentNumber String       @unique @map("document_number")
  position       String       // Cargo / Puesto
  department     String?      // Área (Tecnología, Educación, Admin...)
  employeeType   EmployeeType @default(EMPLOYEE) @map("employee_type")
  startDate      DateTime     @map("start_date")
  birthDate      DateTime?    @map("birth_date")
  address        String?
  city           String?      @default("Colombia")
  isActive       Boolean      @default(true) @map("is_active")
  notes          String?
  avatarUrl      String?      @map("avatar_url")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  contracts      Contract[]
  payrolls       Payroll[]
  timeEntries    TimeEntry[]
  skills         EmployeeSkill[]
  reviews        PerformanceReview[]

  @@map("employees")
}

model Contract {
  id             String         @id @default(uuid())
  employeeId     String         @map("employee_id")
  contractType   ContractType   @map("contract_type")
  status         ContractStatus @default(ACTIVE)
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  salary         Int            @default(0) // Conversión a Int (Sin decimales)
  currency       String         @default("COP")
  workHoursPerWeek Int          @default(40) @map("work_hours_per_week")
  description    String?
  documentUrl    String?        @map("document_url")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Payroll {
  id             String        @id @default(uuid())
  employeeId     String        @map("employee_id")
  period         String        // "2026-03" = Año-Mes
  baseSalary     Int           @default(0) @map("base_salary") // Int sin decimales
  bonuses        Int           @default(0)
  deductions     Int           @default(0)
  netPay         Int           @default(0) @map("net_pay")
  currency       String        @default("COP")
  status         PayrollStatus @default(PENDING)
  paidAt         DateTime?     @map("paid_at")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payrolls")
}

// ─── SD — MÓDULO DE VENTAS Y DISTRIBUCIÓN ────────────────────────────────────

model Customer {
  id             String       @id @default(uuid())
  name           String                          // Empresa o nombre completo
  customerType   CustomerType @default(COMPANY) @map("customer_type")
  email          String?
  phone          String?
  contactPerson  String?      @map("contact_person")  // Nombre del contacto
  documentNumber String?      @map("document_number") // NIT o Cédula
  address        String?
  city           String?
  country        String?      @default("Colombia")
  website        String?
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  quotes         Quote[]
  invoices       Invoice[]
  deals          Deal[]
  projects       Project[]
  tickets        SupportTicket[]

  @@map("customers")
}

model Product {
  id           String          @id @default(uuid())
  name         String
  code         String          @unique           // Ej: GM-LIC-001
  description  String?
  category     ProductCategory @default(OTHER)
  unitPrice    Int             @default(0) @map("unit_price") // Int
  currency     String          @default("COP")
  unit         String          @default("unidad") // "licencia", "hora", "mes"
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  quoteItems   QuoteItem[]
  invoiceItems InvoiceItem[]

  @@map("products")
}

model Quote {
  id           String      @id @default(uuid())
  quoteNumber  String      @unique @map("quote_number") // COT-2026-001
  customerId   String      @map("customer_id")
  status       QuoteStatus @default(DRAFT)
  validUntil   DateTime?   @map("valid_until")
  subtotal     Int         @default(0) // Int
  taxPercent   Int         @default(0) @map("tax_percent") 
  taxAmount    Int         @default(0) @map("tax_amount") 
  total        Int         @default(0) // Int
  currency     String      @default("COP")
  notes        String?
  terms        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  customer     Customer    @relation(fields: [customerId], references: [id])
  items        QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String   @map("quote_id")
  productId   String?  @map("product_id")
  description String
  quantity    Int      @default(1) // Int
  unitPrice   Int      @default(0) @map("unit_price") // Int
  discount    Int      @default(0) // Int
  total       Int      @default(0) // Int

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number") // FAC-2026-001
  customerId    String        @map("customer_id")
  quoteId       String?       @map("quote_id")
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  paidAt        DateTime?     @map("paid_at")
  subtotal      Int           @default(0) // Int
  taxPercent    Int           @default(0) @map("tax_percent") 
  taxAmount     Int           @default(0) @map("tax_amount") 
  total         Int           @default(0) // Int
  currency      String        @default("COP")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer      Customer      @relation(fields: [customerId], references: [id])
  items         InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  productId   String?  @map("product_id")
  description String
  quantity    Int      @default(1) // Int
  unitPrice   Int      @default(0) @map("unit_price") // Int
  discount    Int      @default(0) 
  total       Int      @default(0) // Int

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

model Deal {
  id           String        @id @default(uuid())
  title        String
  customerId   String        @map("customer_id")
  stage        PipelineStage @default(PROSPECT)
  value        Int?          @default(0)          // Int target estimativo
  currency     String        @default("COP")
  expectedDate DateTime?     @map("expected_date")
  closedAt     DateTime?     @map("closed_at")
  probability  Int           @default(10)          // % probabilidad de cierre
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  customer     Customer      @relation(fields: [customerId], references: [id])

  @@map("deals")
}

// ─── FI — MÓDULO DE FINANZAS ──────────────────────────────────────────────────

model Account {
  id          String      @id @default(uuid())
  code        String      @unique                  // Código de cuenta (ej. 1105)
  name        String                             // Nombre de cuenta (ej. Caja General)
  type        AccountType                        // ASSET, LIABILITY, etc.
  description String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  entries     JournalEntryLine[]

  @@map("accounts")
}

model JournalEntry {
  id          String        @id @default(uuid())
  entryNumber String        @unique @map("entry_number") // AS-2026-001
  date        DateTime
  description String
  status      EntryStatus   @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  lines       JournalEntryLine[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id          String       @id @default(uuid())
  entryId     String       @map("entry_id")
  accountId   String       @map("account_id")
  type        EntryType    // DEBIT or CREDIT
  amount      Int          @default(0) // Int
  description String?

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id])

  @@map("journal_entry_lines")
}

// ─── OPERACIONES ──────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  progress    Int      @default(0)          // 0-100
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  budget      Int?     @default(0) // Conversión a Int
  responsible String?
  color       String?  @default("#6366f1")
  customerId  String?  @map("customer_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer     Customer?      @relation(fields: [customerId], references: [id])
  tasks        ProjectTask[]
  deliverables Deliverable[]
  tickets      SupportTicket[]
  repositories Repository[]
  bugs         Bug[]
  timeEntries  TimeEntry[]

  @@map("projects")
}

model ProjectTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO")    // TODO | IN_PROGRESS | REVIEW | DONE
  priority    String   @default("MEDIUM")  // LOW | MEDIUM | HIGH | CRITICAL
  assignee    String?
  dueDate     DateTime? @map("due_date")
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_tasks")
}

model Deliverable {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  fileUrl     String?  @map("file_url")
  dueDate     DateTime? @map("due_date")
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("deliverables")
}

model SupportTicket {
  id          String   @id @default(uuid())
  subject     String
  description String?
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String   @default("OPEN")   // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  reporter    String?
  assignee    String?
  projectId   String?  @map("project_id")
  customerId  String?  @map("customer_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project  Project?  @relation(fields: [projectId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("support_tickets")
}

// ─── DEV MANAGEMENT ──────────────────────────────────────────────────────────

model Repository {
  id            String   @id @default(uuid())
  name          String
  url           String?                         // GitHub / GitLab URL
  language      String?
  description   String?
  defaultBranch String?  @default("main") @map("default_branch")
  isActive      Boolean  @default(true)   @map("is_active")
  projectId     String?  @map("project_id")
  createdAt     DateTime @default(now())  @map("created_at")
  updatedAt     DateTime @updatedAt       @map("updated_at")

  project     Project?     @relation(fields: [projectId], references: [id])
  deployments Deployment[]
  bugs        Bug[]

  @@map("repositories")
}

model Deployment {
  id          String   @id @default(uuid())
  version     String                          // v1.2.0 or commit sha
  environment String   @default("PROD")       // DEV | STAGING | PROD
  status      String   @default("IN_PROGRESS") // SUCCESS | FAILED | IN_PROGRESS | ROLLED_BACK
  notes       String?
  deployedBy  String?  @map("deployed_by")
  deployedAt  DateTime @default(now())  @map("deployed_at")
  repoId      String   @map("repo_id")
  createdAt   DateTime @default(now())  @map("created_at")

  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

model Bug {
  id               String   @id @default(uuid())
  title            String
  description      String?
  severity         String   @default("MEDIUM")  // LOW | MEDIUM | HIGH | CRITICAL
  status           String   @default("OPEN")    // OPEN | IN_PROGRESS | FIXED | WONT_FIX | CLOSED
  assignee         String?
  stepsToReproduce String?  @map("steps_to_reproduce")
  labels           String?                       // comma-separated tags
  repoId           String   @map("repo_id")
  projectId        String?  @map("project_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  project    Project?   @relation(fields: [projectId], references: [id])

  @@map("bugs")
}


model TimeEntry {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  date        DateTime
  hours       Int      @default(0) // Conversión a Int (Sin float)
  description String?
  projectId   String?  @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id])

  @@map("time_entries")
}

model EmployeeSkill {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  name       String
  level      String   @default("INTERMEDIATE")
  category   String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_skills")
}

model PerformanceReview {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  period       String
  score        Int
  strengths    String?
  improvements String?
  reviewerName String?  @map("reviewer_name")
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("performance_reviews")
}

// ─── EDUCACIÓN ────────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  level       String   @default("BEGINNER")   // BEGINNER | INTERMEDIATE | ADVANCED
  category    String?
  coverUrl    String?  @map("cover_url")
  price       Int      @default(0) // Sin decimales
  currency    String?  @default("COP")
  instructor  String?
  status      String   @default("DRAFT")      // DRAFT | PUBLISHED | ARCHIVED
  durationH   Int      @default(0) @map("duration_h") // Int
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lessons     Lesson[]
  enrollments Enrollment[]
  assessments Assessment[]

  @@map("courses")
}

model Lesson {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  type        String   @default("VIDEO")      // VIDEO | READING | QUIZ | ACTIVITY
  contentUrl  String?  @map("content_url")
  durationMin Int?     @default(0) @map("duration_min")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Enrollment {
  id            String    @id @default(uuid())
  courseId      String    @map("course_id")
  
  // Enlace directo al usuario global (Plataforma Educativa Estructurada)
  studentId     String    @map("student_id")
  
  progress      Int       @default(0)          // 0-100
  status        String    @default("ACTIVE")   // ACTIVE | COMPLETED | DROPPED
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@map("enrollments")
}

model Assessment {
  id           String   @id @default(uuid())
  courseId     String   @map("course_id")
  enrollmentId String?  @map("enrollment_id")
  title        String
  type         String   @default("QUIZ")    // QUIZ | PROJECT | EXAM
  maxScore     Int      @default(100) @map("max_score") // Int
  score        Int? // Int
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@map("assessments")
}

// ─── COMUNICACIONES ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO")    // ALERT | INFO | WARNING | SUCCESS
  module    String?                       // finance | ops | edu | hcm | crm | dev
  linkUrl   String?  @map("link_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model InternalMessage {
  id          String    @id @default(uuid())
  fromName    String    @map("from_name")
  fromEmail   String?   @map("from_email")
  toName      String    @map("to_name")
  toEmail     String?   @map("to_email")
  subject     String
  body        String
  isRead      Boolean   @default(false) @map("is_read")
  replyToId   String?   @map("reply_to_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  replyTo  InternalMessage?  @relation("Replies", fields: [replyToId], references: [id])
  replies  InternalMessage[] @relation("Replies")

  @@map("internal_messages")
}

// ─── VIDEOGAME ───────────────────────────────────────────────────────────────

model GameSession {
  id        String   @id @default(uuid())
  playerId  String   @map("player_id")
  score     Int      @default(0)
  level     Int      @default(1)
  data      Json?
  startedAt DateTime @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  player    User     @relation(fields: [playerId], references: [id])

  @@map("game_sessions")
}

model GameAsset {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String   @default("IMAGE") // IMAGE, AUDIO, 3D_MODEL, OTHER
  size      Int
